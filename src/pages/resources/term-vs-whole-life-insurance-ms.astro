    margin-bottom: var(--space-xs);
    font-size: 1.1rem;
  }

  .guide-cta-box {
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    border-radius: var(--border-radius);
    padding: var(--space-2xl);
    margin-top: var(--space-3xl);
    text-align: center;
  }

  .guide-cta-box h3 {
    margin-bottom: var(--space-xs);
    color: var(--gray-900);
  }

  .guide-cta-box p {
    max-width: 540px;
    margin: 0 auto var(--space-lg);
    font-size: 0.98rem;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .sidebar-widget {
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-radius: var(--border-radius);
    padding: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .sidebar-widget h4 {
    font-size: 1.1rem;
    margin-bottom: var(--space-md);
    color: var(--gray-900);
  }

  .summary-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .summary-list li {
    font-size: 0.92rem;
    color: var(--gray-700);
    border-bottom: 1px solid var(--gray-100);
    padding-bottom: var(--space-xs);
  }

  .agent-widget {
    text-align: center;
  }

  .agent-widget img {
    margin-bottom: var(--space-sm);
    border-radius: 8px;
  }

  .agent-widget h5 {
    font-size: 1.05rem;
    margin-bottom: 4px;
  }

  .agent-widget p {
    font-size: 0.88rem;
    color: var(--gray-500);
    margin-bottom: var(--space-md);
  }

  .phone-sidebar {
    display: inline-block;
    font-weight: 800;
    color: var(--brand-red);
    font-size: 1.1rem;
  }

  @media (max-width: 900px) {
    .article-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
