    flex-direction: column;
    gap: var(--space-sm);
  }

  .summary-list li {
    font-size: 0.92rem;
    color: var(--gray-700);
    border-bottom: 1px solid var(--gray-100);
    padding-bottom: var(--space-xs);
  }

  .agent-widget {
    text-align: center;
  }

  .agent-widget img {
    margin-bottom: var(--space-sm);
    border-radius: 8px;
  }

  .agent-widget h5 {
    font-size: 1.05rem;
