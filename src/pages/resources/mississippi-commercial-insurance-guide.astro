  }

  .phone-sidebar {
    display: inline-block;
    font-weight: 800;
    color: var(--brand-red);
    font-size: 1.1rem;
  }

  @media (max-width: 900px) {
    .article-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
