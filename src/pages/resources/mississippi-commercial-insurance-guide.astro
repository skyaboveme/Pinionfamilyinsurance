    color: var(--gray-900);
  }

  .guide-cta-box p {
    max-width: 540px;
    margin: 0 auto var(--space-lg);
    font-size: 0.98rem;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
