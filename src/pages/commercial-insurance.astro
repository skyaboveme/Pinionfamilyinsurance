---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CarrierStrip from '../components/CarrierStrip.astro';
import FAQ from '../components/FAQ.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import QuoteForm from '../components/QuoteForm.astro';
import '../styles/global.css';

const commercialFAQs = [
  {
    question: "What types of business insurance are required in Mississippi?",
    answer: "In Mississippi, businesses with 5 or more employees are legally required to carry Workers' Compensation insurance. Commercial Auto insurance is required for any company-owned vehicles. While General Liability is not mandated by state law, most commercial leases, client contracts, and vendor agreements require it."
  },
  {
    question: "What is a Business Owner's Policy (BOP)?",
    answer: "A Business Owner's Policy (BOP) combines General Liability, Commercial Property, and Business Interruption insurance into a single package, usually at a much lower rate than buying individual policies separately. It is ideal for small to mid-sized Mississippi businesses."
  },
  {
    question: "What local industries in Oxford and Lafayette County do you insure?",
    answer: "We insure a broad range of local businesses: restaurants, retail boutiques on the Square, general and specialty contractors, medical practices, law firms, real estate agencies, auto repair shops, and professional service providers across North Mississippi."
  },
  {
    question: "How does Commercial General Liability protect my business?",
    answer: "General Liability protects your business from financial ruin caused by customer slip-and-falls, property damage caused by your operations, defective products, and advertising injury claims (such as copyright infringement or slander)."
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Commercial & Business Insurance in Oxford, MS",
    "serviceType": "Commercial Insurance",
    "provider": {
      "@type": "InsuranceAgency",
      "name": "Pinion Family Insurance",
      "telephone": "+16626383777",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "2621A W Oxford Loop",
        "addressLocality": "Oxford",
        "addressRegion": "MS",
        "postalCode": "38655"
      }
    },
    "description": "Comprehensive business insurance solutions in Oxford, Mississippi. General liability, commercial property, workers comp, and commercial auto.",
    "areaServed": ["Oxford", "Water Valley", "Batesville", "Holly Springs", "Lafayette County", "Mississippi"]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://pinionfamilyinsurance.com/" },
      { "@type": "ListItem", "position": 2, "name": "Commercial Insurance", "item": "https://pinionfamilyinsurance.com/commercial-insurance" }
    ]
  }
];
---

<BaseLayout
  title="Commercial & Business Insurance Oxford MS | Pinion Family Insurance"
  description="Protect your Oxford, MS business with general liability, commercial property, workers comp, and commercial auto insurance. Compare top commercial carriers today."
  canonical="https://pinionfamilyinsurance.com/commercial-insurance"
  schema={schema}
>
  <Header />

  <!-- Hero Section -->
  <section class="page-hero">
    <div class="page-hero-bg">
      <img src="/images/pinioninsurancecommercial.jpg" alt="Commercial business and retail storefronts in Oxford, MS" width="1920" height="1080" loading="eager" />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="container page-hero-content">
      <div class="breadcrumbs">
        <a href="/">Home</a> <span>/</span> <span class="current">Commercial Insurance</span>
      </div>
      <span class="hero-eyebrow">Enterprise & Small Business Risk Management</span>
      <h1>Commercial Insurance in <span class="highlight-text">Oxford, MS</span></h1>
      <p class="hero-desc">
        You've poured your life into building your business. We provide ironclad commercial insurance coverage tailored to Oxford contractors, retailers, restaurants, and professionals.
      </p>
      <div class="hero-btn-group">
        <a href="#quote-section" class="btn btn-primary btn-lg">Get Free Business Quotes</a>
        <a href="tel:+16626383777" class="btn btn-outline btn-lg">Call (662) 638-3777</a>
      </div>
    </div>
  </section>

  <!-- Content & Quote Grid -->
  <section class="section" id="quote-section">
    <div class="container">
      <div class="service-layout-grid">
        <!-- Details -->
        <div class="service-details">
          <span class="section-eyebrow">Built For Mississippi Business</span>
          <h2>Customized Coverage to Protect Your Bottom Line</h2>
          <p class="lead-text">
            No two businesses face the same liability risks. As an independent commercial agency, Pinion Family Insurance partners with premier underwriters (including The Hartford, Travelers, and Liberty Mutual) to craft a policy package tailored to your exact industry.
          </p>

          <div class="coverage-features-box">
            <h3>Essential Commercial Coverages:</h3>
            <ul class="coverage-list">
              <li>
                <div class="check-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <div>
                  <strong>Commercial General Liability (CGL):</strong>
                  <p>Covers bodily injuries on premises, client property damage, products/completed operations, and personal advertising injuries.</p>
                </div>
              </li>
              <li>
                <div class="check-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <div>
                  <strong>Commercial Property Insurance:</strong>
                  <p>Protects your physical building, tools, inventory, office furnishings, machinery, and equipment against fire, wind, and theft.</p>
                </div>
              </li>
              <li>
                <div class="check-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <div>
                  <strong>Workers' Compensation:</strong>
                  <p>Pays medical expenses and replacement wages for employees injured on the job, shielding your enterprise from costly lawsuits.</p>
                </div>
              </li>
              <li>
                <div class="check-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <div>
                  <strong>Commercial Auto & Fleet:</strong>
                  <p>Covers work trucks, delivery vans, and business vehicles with higher liability limits and physical damage protection.</p>
                </div>
              </li>
              <li>
                <div class="check-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <div>
                  <strong>Business Owner's Policy (BOP):</strong>
                  <p>All-in-one bundled policy providing essential liability and property coverage at discounted package rates for small businesses.</p>
                </div>
              </li>
            </ul>
          </div>

          <div class="discounts-callout">
            <h3>Industries We Specialize In:</h3>
            <div class="discount-tags">
              <span class="tag">Contractors & Construction</span>
              <span class="tag">Restaurants & Cafes</span>
              <span class="tag">Retail & Boutiques</span>
              <span class="tag">Medical & Dental Clinics</span>
              <span class="tag">Law & Financial Firms</span>
              <span class="tag">Auto Repair & Service Shops</span>
            </div>
          </div>
        </div>

        <!-- Sidebar / Quote -->
        <div class="service-sidebar">
          <QuoteForm defaultInsuranceType="Commercial Insurance" formTitle="Get a Commercial Quote" />
          
          <div class="local-trust-card">
            <h4>Commercial Insurance Advantage</h4>
            <ul class="trust-points">
              <li>📜 <strong>Rapid COIs:</strong> Get Certificates of Insurance issued quickly for your clients and jobs.</li>
              <li>🔍 <strong>Multi-Carrier Shop:</strong> The Hartford, Travelers, Nationwide, Progressive, and more.</li>
              <li>📈 <strong>Scalable Policies:</strong> We adjust coverage as your revenue, payroll, and fleet grow.</li>
              <li>📍 <strong>Local Representation:</strong> We understand Lafayette County business regulations.</li>
            </ul>
            <div class="call-direct">
              <span>Need a fast commercial consultation?</span>
              <a href="tel:+16626383777" class="direct-phone-btn">📞 (662) 638-3777</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Carrier Strip -->
  <CarrierStrip />

  <!-- FAQ Section -->
  <FAQ
    title="Commercial Insurance FAQs"
    subtitle="Common business coverage, claims, and compliance questions in Mississippi."
    items={commercialFAQs}
    idPrefix="commercial"
  />

  <Footer />
  <FloatingCTA />
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    background: linear-gradient(135deg, var(--navy) 0%, #0d1726 100%);
    padding: calc(var(--header-height) + var(--space-3xl)) 0 var(--space-4xl);
    color: var(--white);
    overflow: hidden;
  }

  .page-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      135deg,
      rgba(10, 15, 26, 0.90) 0%,
      rgba(10, 15, 26, 0.75) 45%,
      rgba(10, 15, 26, 0.88) 100%
    );
  }

  .page-hero-content {
    position: relative;
    z-index: 2;
    max-width: 840px;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--gray-400);
    margin-bottom: var(--space-md);
  }

  .breadcrumbs a {
    color: var(--gray-300);
  }

  .breadcrumbs a:hover {
    color: var(--white);
  }

  .breadcrumbs .current {
    color: var(--brand-red-light);
    font-weight: 600;
  }

  .hero-eyebrow {
    display: inline-block;
    color: var(--brand-red-light);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-xs);
  }

  .page-hero h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    color: var(--white);
    margin-bottom: var(--space-md);
  }

  .highlight-text {
    color: var(--brand-red-light);
  }

  .hero-desc {
    font-size: 1.15rem;
    color: var(--gray-300);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .hero-btn-group {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .service-layout-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .service-details h2 {
    font-size: 2.2rem;
    margin-bottom: var(--space-md);
    color: var(--gray-900);
  }

  .lead-text {
    font-size: 1.1rem;
    color: var(--gray-600);
    line-height: 1.8;
    margin-bottom: var(--space-2xl);
  }

  .coverage-features-box {
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    border-radius: var(--border-radius-lg);
    padding: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .coverage-features-box h3 {
    font-size: 1.35rem;
    margin-bottom: var(--space-lg);
    color: var(--navy);
  }

  .coverage-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .coverage-list li {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .check-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(235, 29, 36, 0.1);
    color: var(--brand-red);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .coverage-list strong {
    display: block;
    color: var(--gray-900);
    font-size: 1.05rem;
    margin-bottom: 3px;
  }

  .coverage-list p {
    color: var(--gray-600);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .discounts-callout {
    background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
    color: var(--white);
    padding: var(--space-xl);
    border-radius: var(--border-radius-lg);
  }

  .discounts-callout h3 {
    color: var(--white);
    font-size: 1.2rem;
    margin-bottom: var(--space-sm);
  }

  .discount-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .discount-tags .tag {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 6px 14px;
    border-radius: var(--border-radius-pill);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .service-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    position: sticky;
    top: calc(var(--header-height) + 20px);
  }

  .local-trust-card {
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    border-radius: var(--border-radius-lg);
    padding: var(--space-xl);
  }

  .local-trust-card h4 {
    font-size: 1.15rem;
    color: var(--navy);
    margin-bottom: var(--space-md);
  }

  .trust-points {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-size: 0.92rem;
    color: var(--gray-700);
    margin-bottom: var(--space-lg);
  }

  .call-direct {
    border-top: 1px solid var(--gray-200);
    padding-top: var(--space-md);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .call-direct span {
    font-size: 0.85rem;
    color: var(--gray-500);
  }

  .direct-phone-btn {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--brand-red);
  }

  .direct-phone-btn:hover {
    color: var(--brand-red-dark);
  }

  @media (max-width: 992px) {
    .service-layout-grid {
      grid-template-columns: 1fr;
    }
    .service-sidebar {
      position: static;
    }
  }
</style>
