---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CarrierStrip from '../components/CarrierStrip.astro';
import FAQ from '../components/FAQ.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import QuoteForm from '../components/QuoteForm.astro';
import '../styles/global.css';

const homeFAQs = [
  {
    question: "What does standard homeowners insurance cover in Mississippi?",
    answer: "A standard Mississippi homeowners policy (HO-3) covers dwelling damage (roof, walls, structure), other structures (detached garages, fences, sheds), personal property (furniture, appliances, electronics, clothing), loss of use (living expenses if your home is uninhabitable during repairs), and personal liability protection."
  },
  {
    question: "Does homeowners insurance cover storm, hail, or tornado damage in Oxford, MS?",
    answer: "Yes, wind and hail damage (including tornado events) are standard covered perils in most Mississippi home insurance policies. It is important to understand your wind/hail deductible, which may be a flat dollar amount or a percentage of your dwelling value."
  },
  {
    question: "Is flood insurance included in standard home insurance?",
    answer: "No. Flooding from external water sources (heavy rains, overflowing creeks, storm runoff) requires a separate flood insurance policy through the National Flood Insurance Program (NFIP) or private flood carriers. We can help you determine if your property is in a flood zone and bind coverage."
  },
  {
    question: "How can I lower my Mississippi home insurance premium?",
    answer: "You can save substantially by bundling home and auto policies with the same carrier, installing monitored security or smoke alarm systems, maintaining a newer roof, increasing your deductible, and allowing Pinion Family Insurance to compare rates with multiple national providers."
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Homeowners Insurance in Oxford, MS",
    "serviceType": "Home Insurance",
    "provider": {
      "@type": "InsuranceAgency",
      "name": "Pinion Family Insurance",
      "telephone": "+16626383777",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "2621A W Oxford Loop",
        "addressLocality": "Oxford",
        "addressRegion": "MS",
        "postalCode": "38655"
      }
    },
    "description": "Comprehensive homeowners insurance in Oxford, Mississippi. Protect your dwelling, personal property, and liability with top carriers.",
    "areaServed": ["Oxford", "Water Valley", "Batesville", "Holly Springs", "Lafayette County", "Mississippi"]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://pinionfamilyinsurance.com/" },
      { "@type": "ListItem", "position": 2, "name": "Home Insurance", "item": "https://pinionfamilyinsurance.com/home-insurance" }
    ]
  }
];
---

<BaseLayout
  title="Home Insurance Oxford MS | Pinion Family Insurance"
  description="Protect your home and belongings in Oxford, MS. Compare rates from 15+ top homeowners insurance carriers with Pinion Family Insurance. Get a free quote today!"
  canonical="https://pinionfamilyinsurance.com/home-insurance"
  schema={schema}
>
  <Header />

  <!-- Hero Section -->
  <section class="page-hero">
    <div class="page-hero-bg">
      <img src="/images/oxfordhome.jpg" alt="Beautiful residential home in Oxford, Mississippi" width="1920" height="1080" loading="eager" />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="container page-hero-content">
      <div class="breadcrumbs">
        <a href="/">Home</a> <span>/</span> <span class="current">Home Insurance</span>
      </div>
      <span class="hero-eyebrow">Protect Your Greatest Investment</span>
      <h1>Homeowners Insurance in <span class="highlight-text">Oxford, MS</span></h1>
      <p class="hero-desc">
        Your home is where your life happens. We help Lafayette County homeowners secure full-replacement coverage and liability protection from top-rated carriers.
      </p>
      <div class="hero-btn-group">
        <a href="#quote-section" class="btn btn-primary btn-lg">Get Free Home Quotes</a>
        <a href="tel:+16626383777" class="btn btn-outline btn-lg">Call (662) 638-3777</a>
      </div>
    </div>
  </section>

  <!-- Content & Quote Section -->
  <section class="section" id="quote-section">
    <div class="container">
      <div class="service-layout-grid">
        <!-- Details -->
        <div class="service-details">
          <span class="section-eyebrow">Total Peace of Mind</span>
          <h2>Comprehensive Home Coverage Crafted for Oxford Living</h2>
          <p class="lead-text">
            From historic homes near the Oxford Square to newly built developments throughout Lafayette County, Mississippi weather and unexpected emergencies require insurance you can depend on without question.
          </p>

          <div class="coverage-features-box">
            <h3>Standard Homeowners Protections Included:</h3>
            <ul class="coverage-list">
              <li>
                <div class="check-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <div>
                  <strong>Dwelling & Structure Replacement:</strong>
                  <p>Covers the physical rebuild cost of your house, roof, electrical, and plumbing against fire, storms, wind, and lightning.</p>
                </div>
              </li>
              <li>
                <div class="check-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <div>
                  <strong>Personal Property Protection:</strong>
                  <p>Replaces your furniture, electronics, clothing, and everyday valuables if stolen or destroyed in a covered event.</p>
                </div>
              </li>
              <li>
                <div class="check-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <div>
                  <strong>Personal Liability Coverage:</strong>
                  <p>Protects your personal assets and pays legal defense costs if someone is accidentally injured on your property.</p>
                </div>
              </li>
              <li>
                <div class="check-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <div>
                  <strong>Loss of Use / Additional Living Expenses:</strong>
                  <p>Pays for hotel stays, temporary rent, and restaurant meals if your home becomes unlivable during storm repairs.</p>
                </div>
              </li>
              <li>
                <div class="check-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <div>
                  <strong>Detached Structures Coverage:</strong>
                  <p>Safeguards your detached garage, workshop, pool house, fencing, or storage sheds on the premises.</p>
                </div>
              </li>
            </ul>
          </div>

          <div class="discounts-callout">
            <h3>Bundle Auto + Home & Save Up to 25%</h3>
            <p style="margin-bottom: var(--space-md); color: var(--gray-300);">
              Combining your auto policy and home policy under one carrier is the single most effective way to lower your insurance costs in Mississippi.
            </p>
            <div class="discount-tags">
              <span class="tag">Multi-Policy Discount</span>
              <span class="tag">New Roof Credit</span>
              <span class="tag">Security System Discount</span>
              <span class="tag">Claims-Free Discount</span>
              <span class="tag">Gated Community / Deadbolt</span>
            </div>
          </div>
        </div>

        <!-- Sidebar / Quote -->
        <div class="service-sidebar">
          <QuoteForm defaultInsuranceType="Home Insurance" formTitle="Get a Home Insurance Quote" />
          
          <div class="local-trust-card">
            <h4>Local Advice You Can Trust</h4>
            <ul class="trust-points">
              <li>🏡 <strong>Local Property Knowledge:</strong> We know North Mississippi building values and storm risks.</li>
              <li>🔍 <strong>Multi-Carrier Comparison:</strong> Travelers, Safeco, Nationwide, Progressive, and more.</li>
              <li>🛡️ <strong>Replacement Cost Reviews:</strong> Ensure your dwelling limits keep up with inflation.</li>
              <li>⭐ <strong>Direct Claim Advocate:</strong> We walk you through every step if disaster strikes.</li>
            </ul>
            <div class="call-direct">
              <span>Have a question about your home policy?</span>
              <a href="tel:+16626383777" class="direct-phone-btn">📞 (662) 638-3777</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Carrier Strip -->
  <CarrierStrip />

  <!-- FAQ Section -->
  <FAQ
    title="Home Insurance FAQs"
    subtitle="Answers to the most common questions regarding homeowners coverage in Oxford, MS."
    items={homeFAQs}
    idPrefix="home"
  />

  <Footer />
  <FloatingCTA />
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    background: linear-gradient(135deg, var(--navy) 0%, #0d1726 100%);
    padding: calc(var(--header-height) + var(--space-3xl)) 0 var(--space-4xl);
    color: var(--white);
    overflow: hidden;
  }

  .page-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      135deg,
      rgba(10, 15, 26, 0.90) 0%,
      rgba(10, 15, 26, 0.75) 45%,
      rgba(10, 15, 26, 0.88) 100%
    );
  }

  .page-hero-content {
    position: relative;
    z-index: 2;
    max-width: 840px;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--gray-400);
    margin-bottom: var(--space-md);
  }

  .breadcrumbs a {
    color: var(--gray-300);
  }

  .breadcrumbs a:hover {
    color: var(--white);
  }

  .breadcrumbs .current {
    color: var(--brand-red-light);
    font-weight: 600;
  }

  .hero-eyebrow {
    display: inline-block;
    color: var(--brand-red-light);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-xs);
  }

  .page-hero h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    color: var(--white);
    margin-bottom: var(--space-md);
  }

  .highlight-text {
    color: var(--brand-red-light);
  }

  .hero-desc {
    font-size: 1.15rem;
    color: var(--gray-300);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .hero-btn-group {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .service-layout-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .service-details h2 {
    font-size: 2.2rem;
    margin-bottom: var(--space-md);
    color: var(--gray-900);
  }

  .lead-text {
    font-size: 1.1rem;
    color: var(--gray-600);
    line-height: 1.8;
    margin-bottom: var(--space-2xl);
  }

  .coverage-features-box {
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    border-radius: var(--border-radius-lg);
    padding: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .coverage-features-box h3 {
    font-size: 1.35rem;
    margin-bottom: var(--space-lg);
    color: var(--navy);
  }

  .coverage-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .coverage-list li {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .check-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(235, 29, 36, 0.1);
    color: var(--brand-red);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .coverage-list strong {
    display: block;
    color: var(--gray-900);
    font-size: 1.05rem;
    margin-bottom: 3px;
  }

  .coverage-list p {
    color: var(--gray-600);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .discounts-callout {
    background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
    color: var(--white);
    padding: var(--space-xl);
    border-radius: var(--border-radius-lg);
  }

  .discounts-callout h3 {
    color: var(--white);
    font-size: 1.2rem;
    margin-bottom: var(--space-sm);
  }

  .discount-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .discount-tags .tag {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 6px 14px;
    border-radius: var(--border-radius-pill);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .service-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    position: sticky;
    top: calc(var(--header-height) + 20px);
  }

  .local-trust-card {
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    border-radius: var(--border-radius-lg);
    padding: var(--space-xl);
  }

  .local-trust-card h4 {
    font-size: 1.15rem;
    color: var(--navy);
    margin-bottom: var(--space-md);
  }

  .trust-points {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-size: 0.92rem;
    color: var(--gray-700);
    margin-bottom: var(--space-lg);
  }

  .call-direct {
    border-top: 1px solid var(--gray-200);
    padding-top: var(--space-md);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .call-direct span {
    font-size: 0.85rem;
    color: var(--gray-500);
  }

  .direct-phone-btn {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--brand-red);
  }

  .direct-phone-btn:hover {
    color: var(--brand-red-dark);
  }

  @media (max-width: 992px) {
    .service-layout-grid {
      grid-template-columns: 1fr;
    }
    .service-sidebar {
      position: static;
    }
  }
</style>
