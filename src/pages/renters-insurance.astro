---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CarrierStrip from '../components/CarrierStrip.astro';
import FAQ from '../components/FAQ.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import QuoteForm from '../components/QuoteForm.astro';
import '../styles/global.css';

const rentersFAQs = [
  {
    question: "Doesn't my landlord's insurance cover my belongings?",
    answer: "No. Your landlord's policy only covers the physical building structure. If a fire, burst pipe, or break-in occurs, your personal furniture, electronics, clothing, and computers are NOT covered unless you have your own renters insurance policy."
  },
  {
    question: "How much does renters insurance cost in Oxford, MS?",
    answer: "Renters insurance is extremely affordable—often averaging just $12 to $20 per month (less than 50 cents a day). If you bundle it with your auto insurance, the multi-policy discount on your auto policy can sometimes offset the entire cost of renters coverage."
  },
  {
    question: "Are Ole Miss college students covered by renters insurance?",
    answer: "If a student lives off-campus in Oxford apartments or rental homes, a renters policy protects their laptop, phone, textbooks, bicycle, and personal belongings from theft or damage, while providing personal liability coverage."
  },
  {
    question: "What is Loss of Use coverage in a renters policy?",
    answer: "If your apartment or rental house becomes uninhabitable due to a covered peril (such as an apartment fire or severe storm damage), Loss of Use pays for temporary hotel accommodations, extra food costs, and relocation expenses."
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Renters Insurance in Oxford, MS",
    "serviceType": "Renters Insurance",
    "provider": {
      "@type": "InsuranceAgency",
      "name": "Pinion Family Insurance",
      "telephone": "+16626383777",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "2621A W Oxford Loop",
        "addressLocality": "Oxford",
        "addressRegion": "MS",
        "postalCode": "38655"
      }
    },
    "description": "Affordable renters insurance in Oxford, Mississippi. Protect your personal belongings and liability in rental homes and apartments.",
    "areaServed": ["Oxford", "Water Valley", "Batesville", "Holly Springs", "Lafayette County", "Mississippi"]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://pinionfamilyinsurance.com/" },
      { "@type": "ListItem", "position": 2, "name": "Renters Insurance", "item": "https://pinionfamilyinsurance.com/renters-insurance" }
    ]
  }
];
---

<BaseLayout
  title="Renters Insurance Oxford MS | Pinion Family Insurance"
  description="Protect your apartment, furniture, laptop, and valuables in Oxford, MS. Renters policies start under $15/mo. Compare top carriers with Pinion Family Insurance!"
  canonical="https://pinionfamilyinsurance.com/renters-insurance"
  schema={schema}
>
  <Header />

  <!-- Hero Section -->
  <section class="page-hero">
    <div class="page-hero-bg">
      <img src="/images/pinionrenters.jpg" alt="Apartment community and residential rental properties in Oxford, MS" width="1920" height="1080" loading="eager" />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="container page-hero-content">
      <div class="breadcrumbs">
        <a href="/">Home</a> <span>/</span> <span class="current">Renters Insurance</span>
      </div>
      <span class="hero-eyebrow">Affordable Protection For Renters & Students</span>
      <h1>Renters Insurance in <span class="highlight-text">Oxford, MS</span></h1>
      <p class="hero-desc">
        Your landlord insures the building, but only you can protect your personal belongings. Get complete property and liability coverage for less than the cost of a couple coffees a month.
      </p>
      <div class="hero-btn-group">
        <a href="#quote-section" class="btn btn-primary btn-lg">Get Free Renters Quotes</a>
        <a href="tel:+16626383777" class="btn btn-outline btn-lg">Call (662) 638-3777</a>
      </div>
    </div>
  </section>

  <!-- Content & Quote Grid -->
  <section class="section" id="quote-section">
    <div class="container">
      <div class="service-layout-grid">
        <!-- Details -->
        <div class="service-details">
          <span class="section-eyebrow">Maximum Value, Minimal Cost</span>
          <h2>Everything You Own, Protected for Pennies a Day</h2>
          <p class="lead-text">
            Whether you rent a house in Lafayette County or an apartment near the University of Mississippi campus, replacing your wardrobe, computer, television, and furniture after an unexpected disaster would cost thousands. Renters insurance ensures you never have to start from scratch.
          </p>

          <div class="coverage-features-box">
            <h3>What Your Renters Policy Covers:</h3>
            <ul class="coverage-list">
              <li>
                <div class="check-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <div>
                  <strong>Personal Property Protection:</strong>
                  <p>Full replacement cost for electronics, clothing, furniture, musical instruments, and jewelry against theft, fire, smoke, and water pipe bursts.</p>
                </div>
              </li>
              <li>
                <div class="check-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <div>
                  <strong>Worldwide Belongings Coverage:</strong>
                  <p>Your property is covered even when you travel—if your laptop or backpack is stolen from your car or hotel, your renters policy steps in.</p>
                </div>
              </li>
              <li>
                <div class="check-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <div>
                  <strong>Personal Liability & Medical Payments:</strong>
                  <p>Shields you if a guest trips in your apartment or if you accidentally cause property damage to a neighboring unit.</p>
                </div>
              </li>
              <li>
                <div class="check-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <div>
                  <strong>Loss of Use (Temporary Housing):</strong>
                  <p>Covers hotel stays, emergency housing, and food expenses if a fire or burst pipe renders your rental temporarily uninhabitable.</p>
                </div>
              </li>
            </ul>
          </div>

          <div class="discounts-callout">
            <h3>Pro-Tip: Bundle With Auto For Maximum Savings</h3>
            <p style="margin-bottom: var(--space-md); color: var(--gray-300);">
              Adding renters insurance to your existing auto policy often activates a bundle discount large enough to cover the renters policy cost.
            </p>
            <div class="discount-tags">
              <span class="tag">Auto + Renters Bundle</span>
              <span class="tag">Security Alarm Credit</span>
              <span class="tag">Gated Community Discount</span>
              <span class="tag">Claims-Free Discount</span>
            </div>
          </div>
        </div>

        <!-- Sidebar / Quote -->
        <div class="service-sidebar">
          <QuoteForm defaultInsuranceType="Renters Insurance" formTitle="Get a Renters Quote" />
          
          <div class="local-trust-card">
            <h4>Instant Landlord Proof of Insurance</h4>
            <ul class="trust-points">
              <li>📄 <strong>Quick Confirmation:</strong> We send proof of insurance directly to your landlord or property manager.</li>
              <li>🔍 <strong>Top Carriers:</strong> Progressive, Safeco, Travelers, Nationwide.</li>
              <li>🎓 <strong>Student Friendly:</strong> Fast policies for Ole Miss off-campus housing.</li>
              <li>⭐ <strong>Local Support:</strong> Friendly guidance right here in Oxford.</li>
            </ul>
            <div class="call-direct">
              <span>Need a policy today?</span>
              <a href="tel:+16626383777" class="direct-phone-btn">📞 (662) 638-3777</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Carrier Strip -->
  <CarrierStrip />

  <!-- FAQ Section -->
  <FAQ
    title="Renters Insurance FAQs"
    subtitle="Helpful answers about tenant coverage in Oxford and North Mississippi."
    items={rentersFAQs}
    idPrefix="renters"
  />

  <Footer />
  <FloatingCTA />
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    background: linear-gradient(135deg, var(--navy) 0%, #0d1726 100%);
    padding: calc(var(--header-height) + var(--space-3xl)) 0 var(--space-4xl);
    color: var(--white);
    overflow: hidden;
  }

  .page-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      135deg,
      rgba(10, 15, 26, 0.90) 0%,
      rgba(10, 15, 26, 0.75) 45%,
      rgba(10, 15, 26, 0.88) 100%
    );
  }

  .page-hero-content {
    position: relative;
    z-index: 2;
    max-width: 840px;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--gray-400);
    margin-bottom: var(--space-md);
  }

  .breadcrumbs a {
    color: var(--gray-300);
  }

  .breadcrumbs a:hover {
    color: var(--white);
  }

  .breadcrumbs .current {
    color: var(--brand-red-light);
    font-weight: 600;
  }

  .hero-eyebrow {
    display: inline-block;
    color: var(--brand-red-light);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-xs);
  }

  .page-hero h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    color: var(--white);
    margin-bottom: var(--space-md);
  }

  .highlight-text {
    color: var(--brand-red-light);
  }

  .hero-desc {
    font-size: 1.15rem;
    color: var(--gray-300);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .hero-btn-group {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .service-layout-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .service-details h2 {
    font-size: 2.2rem;
    margin-bottom: var(--space-md);
    color: var(--gray-900);
  }

  .lead-text {
    font-size: 1.1rem;
    color: var(--gray-600);
    line-height: 1.8;
    margin-bottom: var(--space-2xl);
  }

  .coverage-features-box {
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    border-radius: var(--border-radius-lg);
    padding: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .coverage-features-box h3 {
    font-size: 1.35rem;
    margin-bottom: var(--space-lg);
    color: var(--navy);
  }

  .coverage-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .coverage-list li {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .check-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(235, 29, 36, 0.1);
    color: var(--brand-red);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .coverage-list strong {
    display: block;
    color: var(--gray-900);
    font-size: 1.05rem;
    margin-bottom: 3px;
  }

  .coverage-list p {
    color: var(--gray-600);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .discounts-callout {
    background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
    color: var(--white);
    padding: var(--space-xl);
    border-radius: var(--border-radius-lg);
  }

  .discounts-callout h3 {
    color: var(--white);
    font-size: 1.2rem;
    margin-bottom: var(--space-sm);
  }

  .discount-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .discount-tags .tag {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 6px 14px;
    border-radius: var(--border-radius-pill);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .service-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    position: sticky;
    top: calc(var(--header-height) + 20px);
  }

  .local-trust-card {
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    border-radius: var(--border-radius-lg);
    padding: var(--space-xl);
  }

  .local-trust-card h4 {
    font-size: 1.15rem;
    color: var(--navy);
    margin-bottom: var(--space-md);
  }

  .trust-points {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-size: 0.92rem;
    color: var(--gray-700);
    margin-bottom: var(--space-lg);
  }

  .call-direct {
    border-top: 1px solid var(--gray-200);
    padding-top: var(--space-md);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .call-direct span {
    font-size: 0.85rem;
    color: var(--gray-500);
  }

  .direct-phone-btn {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--brand-red);
  }

  .direct-phone-btn:hover {
    color: var(--brand-red-dark);
  }

  @media (max-width: 992px) {
    .service-layout-grid {
      grid-template-columns: 1fr;
    }
    .service-sidebar {
      position: static;
    }
  }
</style>
