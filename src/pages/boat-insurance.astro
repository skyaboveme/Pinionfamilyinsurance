---
import ProductPageLayout from '../layouts/ProductPageLayout.astro';

const faqs = [
  {
    question: "Is boat insurance required in Mississippi?",
    answer: "Mississippi doesn't have a general state law requiring boat insurance, but that doesn't mean you won't need it. Lenders typically require coverage if your boat is financed, and many marinas require proof of liability coverage to rent a slip. Without insurance, you could be personally responsible for injuries or damage you cause on the water."
  },
  {
    question: "Doesn't my homeowners policy cover my boat?",
    answer: "Usually only in a very limited way. Many homeowners policies offer little or no coverage for boats, and often exclude larger motors, higher-value boats, and liability while you're on the water. A dedicated boat policy provides much broader physical damage and liability protection."
  },
  {
    question: "What types of watercraft do you insure?",
    answer: "We insure pontoons, bass and fishing boats, ski and wake boats, deck boats, runabouts, jon boats, sailboats, and personal watercraft like Jet Skis and WaveRunners. ATVs, UTVs, and golf carts can be covered through our motorcycle and powersports coverage."
  },
  {
    question: "Does boat insurance cover my trailer and fishing gear?",
    answer: "Many boat policies can include coverage for your trailer and offer optional coverage for fishing equipment, electronics like fish finders and trolling motors, and personal effects. Limits vary by carrier, so we'll make sure the policy matches your setup."
  },
  {
    question: "Can I save by bundling boat insurance?",
    answer: "Often, yes. Many carriers offer multi-policy discounts when you bundle boat coverage with your auto or home insurance, plus discounts for completing a boating safety course and for experienced boat owners."
  }
];
