---
// Interactive Multi-Policy Bundle & Save Calculator
---

<section class="section bundle-calc-section" id="bundle-calculator">
  <div class="container">
    <div class="bundle-card animate-on-scroll">
      <div class="bundle-grid">
        <div class="bundle-info">
          <span class="section-eyebrow" style="color: var(--brand-red-light);">Multi-Policy Advantage</span>
          <h2 class="bundle-title">How Much Can You Save By <span class="highlight-white">Bundling?</span></h2>
          <p class="bundle-subtitle">
            Most Mississippi families save 15% to 25% by combining auto, home, and umbrella coverage under one top-rated independent carrier.
          </p>

          <div class="bundle-features">
            <div class="b-feat">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Single deductible options on qualifying storm claims</span>
            </div>
            <div class="b-feat">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>One local agent & single renewal timeline</span>
            </div>
            <div class="b-feat">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Instant multi-vehicle and home safety discounts</span>
            </div>
          </div>
        </div>

        <div class="calculator-box">
          <div class="calc-header">
            <h3>Interactive Bundle Estimator</h3>
            <p>Select the policies you want to protect:</p>
          </div>

          <div class="policy-checkboxes" id="policy-toggles">
            <label class="calc-toggle active">
              <input type="checkbox" name="policy" value="auto" checked data-savings="240" />
              <div class="toggle-content">
                <span class="toggle-icon">🚗</span>
                <span class="toggle-name">Auto Insurance</span>
              </div>
            </label>

            <label class="calc-toggle active">
              <input type="checkbox" name="policy" value="home" checked data-savings="310" />
              <div class="toggle-content">
                <span class="toggle-icon">🏡</span>
                <span class="toggle-name">Home / Property</span>
              </div>
            </label>

            <label class="calc-toggle">
              <input type="checkbox" name="policy" value="life" data-savings="150" />
              <div class="toggle-content">
                <span class="toggle-icon">🛡️</span>
                <span class="toggle-name">Life Insurance</span>
              </div>
            </label>

            <label class="calc-toggle">
              <input type="checkbox" name="policy" value="umbrella" data-savings="120" />
              <div class="toggle-content">
                <span class="toggle-icon">☂️</span>
                <span class="toggle-name">Umbrella / Excess</span>
              </div>
            </label>
          </div>

          <div class="savings-display">
            <span class="savings-label">Estimated Annual Savings:</span>
            <div class="savings-amount-row">
              <span class="currency">$</span>
              <span class="amount" id="savings-counter">550</span>
              <span class="period">/ year</span>
            </div>
            <p class="savings-note">*Actual savings based on carrier underwriting & coverage selected.</p>
          </div>

          <a href="/contact" class="btn btn-primary btn-block calc-cta" id="calc-cta-btn">
            Lock In My Multi-Policy Discount →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @import '../styles/global.css';

  .bundle-calc-section {
    padding: var(--space-3xl) 0;
  }

  .bundle-card {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border-radius: var(--border-radius-lg);
    padding: var(--space-3xl);
    color: var(--white);
    box-shadow: var(--shadow-xl);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .bundle-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-3xl);
    align-items: center;
  }

  .bundle-title {
    color: var(--white);
    font-size: 2.1rem;
    line-height: 1.2;
    margin-bottom: var(--space-md);
  }

  .highlight-white {
    color: var(--brand-red-light);
  }

  .bundle-subtitle {
    color: var(--gray-300);
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: var(--space-xl);
  }

  .bundle-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .b-feat {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--gray-200);
    font-size: 0.95rem;
  }

  .b-feat svg {
    color: #10b981;
    flex-shrink: 0;
  }

  .calculator-box {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--border-radius);
    padding: var(--space-xl);
  }

  .calc-header h3 {
    color: var(--white);
    font-size: 1.3rem;
    margin-bottom: 4px;
  }

  .calc-header p {
    color: var(--gray-400);
    font-size: 0.88rem;
    margin-bottom: var(--space-lg);
  }

  .policy-checkboxes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .calc-toggle {
    cursor: pointer;
    position: relative;
    user-select: none;
  }

  .calc-toggle input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .toggle-content {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--border-radius-sm);
    transition: all var(--transition-fast);
  }

  .calc-toggle:hover .toggle-content {
    background: rgba(255, 255, 255, 0.1);
  }

  .calc-toggle.active .toggle-content {
    background: rgba(235, 29, 36, 0.2);
    border-color: var(--brand-red);
    box-shadow: 0 0 12px rgba(235, 29, 36, 0.3);
  }

  .toggle-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--white);
  }

  .savings-display {
    background: rgba(0, 0, 0, 0.3);
    border-radius: var(--border-radius-sm);
    padding: var(--space-lg);
    text-align: center;
    margin-bottom: var(--space-lg);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .savings-label {
    display: block;
    font-size: 0.85rem;
    color: var(--gray-400);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }

  .savings-amount-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 4px;
  }

  .currency {
    font-size: 1.8rem;
    font-weight: 800;
    color: #10b981;
  }

  .amount {
    font-size: 3rem;
    font-weight: 900;
    color: #10b981;
    font-family: var(--font-heading);
    line-height: 1;
  }

  .period {
    font-size: 1.1rem;
    color: var(--gray-300);
    font-weight: 600;
  }

  .savings-note {
    font-size: 0.75rem;
    color: var(--gray-500);
    margin-top: 6px;
    margin-bottom: 0;
  }

  .calc-cta {
    width: 100%;
    justify-content: center;
    font-size: 1rem;
    padding: 0.85rem 1.2rem;
  }

  @media (max-width: 900px) {
    .bundle-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .bundle-card {
      padding: var(--space-xl);
    }
    .policy-checkboxes {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const toggles = document.querySelectorAll('#policy-toggles .calc-toggle');
    const counter = document.getElementById('savings-counter');

    function updateSavings() {
      let total = 0;
      let count = 0;
      toggles.forEach(toggle => {
        const checkbox = toggle.querySelector('input[type="checkbox"]');
        if (checkbox && checkbox.checked) {
          total += parseInt(checkbox.getAttribute('data-savings') || '0', 10);
          count++;
          toggle.classList.add('active');
        } else {
          toggle.classList.remove('active');
        }
      });

      // Bundle multiplier bonus
      if (count >= 2) {
        total = Math.round(total * 1.15);
      }
      if (count >= 3) {
        total = Math.round(total * 1.1);
      }

      if (counter) {
        counter.textContent = total.toString();
      }
    }

    toggles.forEach(toggle => {
      const checkbox = toggle.querySelector('input[type="checkbox"]');
      if (checkbox) {
        checkbox.addEventListener('change', updateSavings);
      }
    });

    updateSavings();
  });
</script>
