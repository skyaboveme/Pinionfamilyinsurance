---
const reviews = [
  {
    name: 'Sarah M.',
    location: 'Oxford, MS',
    date: 'Verified Client',
    text: 'Pinion Family Insurance made our insurance shopping completely stress-free. They found us significantly better coverage than our old policy and saved us over $600 a year by bundling our home and vehicles. Melanee and her team are wonderful!',
    rating: 5,
  },
  {
    name: 'James T.',
    location: 'Lafayette County',
    date: 'Business & Commercial',
    text: 'As an Oxford small business owner, having an insurance agent who is actually accessible and understands local Mississippi risks is invaluable. They handle our general liability, property, and fleet with absolute professionalism.',
    rating: 5,
  },
  {
    name: 'Amanda & David R.',
    location: 'Oxford, MS',
    date: 'Home & Auto Policyholder',
    text: 'When severe weather damaged our roof last spring, Pinion Family Insurance was there with us from day one. They guided us through the entire claim process with genuine care. You cannot get this level of service from an 800-number.',
    rating: 5,
  },
  {
    name: 'Michael B.',
    location: 'Water Valley, MS',
    date: 'Life & Auto Client',
    text: 'Melanee took the time to explain the difference between term and permanent life insurance for our young family without any high-pressure sales tactics. Honest, dependable, and truly family-focused.',
    rating: 5,
  }
];
---

<section class="section google-reviews-section" id="reviews">
  <div class="container">
    <div class="google-header animate-on-scroll">
      <div class="google-badge-container">
        <div class="google-logo-badge">
          <svg viewBox="0 0 24 24" width="26" height="26">
            <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
            <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 10.03 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
          </svg>
          <div class="google-rating-info">
            <div class="rating-stars">
              <span class="score">5.0</span>
              <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
            </div>
            <span class="rating-count">87+ Verified 5-Star Reviews</span>
          </div>
        </div>
        <div class="header-text-block">
          <span class="section-eyebrow">Local Trust & Reputation</span>
          <h2>Loved by Families in <span class="highlight">Oxford & North Mississippi</span></h2>
        </div>
      </div>
    </div>

    <div class="reviews-grid">
      {reviews.map((r, i) => (
        <div class="review-card animate-on-scroll" style={`transition-delay: ${i * 0.1}s`}>
          <div class="review-top">
            <div class="reviewer-avatar">{r.name.charAt(0)}</div>
            <div class="reviewer-details">
              <div class="reviewer-name-row">
                <span class="reviewer-name">{r.name}</span>
                <span class="verified-icon" title="Verified Review">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="#1DA1F2"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                </span>
              </div>
              <span class="reviewer-location">{r.location} · <span class="review-tag">{r.date}</span></span>
            </div>
          </div>
          <div class="stars-row">★★★★★</div>
          <p class="review-body">"{r.text}"</p>
        </div>
      ))}
    </div>

    <div class="reviews-footer text-center animate-on-scroll">
      <div class="cta-review-buttons">
        <a href="/contact" class="btn btn-primary">Request a Custom Policy Quote</a>
        <a href="https://www.google.com/maps/search/?api=1&query=Pinion+Family+Insurance+Oxford+MS" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          Find Us on Google Maps
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @import '../styles/global.css';

  .google-reviews-section {
    background: var(--white);
    border-top: 1px solid var(--gray-100);
  }

  .google-header {
    margin-bottom: var(--space-3xl);
  }

  .google-badge-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-xl);
  }

  .google-logo-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    background: var(--gray-50);
    padding: var(--space-md) var(--space-lg);
    border-radius: 999px;
    border: 1px solid var(--gray-200);
    box-shadow: var(--shadow-sm);
  }

  .rating-stars {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .score {
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--gray-900);
  }

  .stars {
    color: #f59e0b;
    font-size: 1.1rem;
    letter-spacing: 2px;
  }

  .rating-count {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--gray-600);
    display: block;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
    margin-bottom: var(--space-3xl);
  }

  .review-card {
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    border-radius: var(--border-radius);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    transition: all var(--transition);
  }

  .review-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(235, 29, 36, 0.2);
    background: var(--white);
  }

  .review-top {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .reviewer-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--brand-red), #b91c1c);
    color: var(--white);
    font-weight: 800;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .reviewer-details {
    display: flex;
    flex-direction: column;
  }

  .reviewer-name-row {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .reviewer-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--gray-900);
  }

  .reviewer-location {
    font-size: 0.82rem;
    color: var(--gray-500);
  }

  .review-tag {
    color: var(--brand-red);
    font-weight: 600;
  }

  .stars-row {
    color: #f59e0b;
    font-size: 1.15rem;
    letter-spacing: 2px;
    margin-bottom: var(--space-sm);
  }

  .review-body {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--gray-700);
    font-style: italic;
    margin: 0;
  }

  .cta-review-buttons {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  @media (max-width: 800px) {
    .reviews-grid {
      grid-template-columns: 1fr;
    }
    .google-badge-container {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
