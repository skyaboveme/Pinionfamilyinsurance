---
---

<div class="floating-cta-container" id="floating-cta">
  <!-- Desktop Floating Pill -->
  <div class="desktop-floating-cta">
    <a href="/contact" class="floating-btn quote-btn" aria-label="Get an insurance quote">
      <span class="icon-pulse"></span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
      <span>Quick Quote</span>
    </a>
    <a href="tel:+16626383777" class="floating-btn phone-btn" aria-label="Call Pinion Family Insurance">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <span>(662) 638-3777</span>
    </a>
  </div>

  <!-- Mobile Fixed Bottom Quick Bar -->
  <div class="mobile-bottom-bar">
    <a href="tel:+16626383777" class="mobile-bar-btn mobile-call">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <span>Call Agent</span>
    </a>
    <a href="/contact" class="mobile-bar-btn mobile-quote">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
      <span>Get Free Quote</span>
    </a>
  </div>
</div>

<style>
  .floating-cta-container {
    z-index: 990;
  }

  /* Desktop Floating Widget */
  .desktop-floating-cta {
    position: fixed;
    bottom: 28px;
    right: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    z-index: 995;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  .desktop-floating-cta.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .floating-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: var(--border-radius-pill);
    font-size: 0.9rem;
    font-weight: 700;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    transition: all var(--transition);
    position: relative;
    overflow: hidden;
  }

  .quote-btn {
    background: var(--brand-red);
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .quote-btn:hover {
    background: var(--brand-red-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(235, 29, 36, 0.35);
  }

  .phone-btn {
    background: var(--navy);
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .phone-btn:hover {
    background: var(--navy-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(10, 15, 26, 0.25);
  }

  .icon-pulse {
    width: 8px;
    height: 8px;
    background-color: #22c55e;
    border-radius: 50%;
    animation: pulse 1.5s infinite;
  }

  /* Mobile Bottom Quick Bar */
  .mobile-bottom-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(17, 24, 39, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 10px 16px;
    z-index: 998;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.2);
    gap: 10px;
  }

  .mobile-bar-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 14px;
    border-radius: var(--border-radius-sm);
    font-size: 0.92rem;
    font-weight: 700;
    text-align: center;
    transition: all var(--transition-fast);
  }

  .mobile-call {
    background: rgba(255, 255, 255, 0.1);
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .mobile-quote {
    background: var(--brand-red);
    color: var(--white);
  }

  @media (max-width: 768px) {
    .desktop-floating-cta {
      display: none;
    }

    .mobile-bottom-bar {
      display: flex;
    }

    /* Add bottom padding to body when mobile bar is visible so content isn't covered */
    :global(body) {
      padding-bottom: 64px;
    }
  }
</style>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const floating = document.querySelector('.desktop-floating-cta');
    const handleScroll = () => {
      if (window.scrollY > 300) {
        floating?.classList.add('visible');
      } else {
        floating?.classList.remove('visible');
      }
    };
    window.addEventListener('scroll', handleScroll);
    handleScroll();
  });
</script>
