---
const servicesList = [
  { label: 'Auto Insurance', href: '/auto-insurance', desc: 'Car, truck & vehicle coverage' },
  { label: 'Home Insurance', href: '/home-insurance', desc: 'Homeowners & property protection' },
  { label: 'Life Insurance', href: '/life-insurance', desc: 'Term & whole life policies' },
  { label: 'Commercial Insurance', href: '/commercial-insurance', desc: 'Business liability & property' },
  { label: 'Renters Insurance', href: '/renters-insurance', desc: 'Apartment & belongings cover' },
  { label: 'Motorcycle Insurance', href: '/motorcycle-insurance', desc: 'Bike, ATV & powersports' },
];

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/#services', isDropdown: true },
  { label: 'About', href: '/about' },
  { label: 'Why Us', href: '/#why-us' },
  { label: 'FAQs', href: '/faq' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="site-header" id="site-header">
  <div class="header-inner container-wide">
    <a href="/" class="logo" aria-label="Pinion Family Insurance - Home">
      <img src="/images/PFI-logo-small.webp" alt="Pinion Family Insurance Logo" width="48" height="48" />
      <div class="logo-text">
        <span class="logo-name">Pinion Family</span>
        <span class="logo-tagline">Insurance</span>
      </div>
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Main navigation">
      <ul class="nav-list">
        {navItems.map(item => (
          item.isDropdown ? (
            <li class="nav-dropdown-wrapper">
              <a href="/#services" class="nav-link dropdown-toggle" aria-haspopup="true">
                <span>{item.label}</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </a>
              <div class="dropdown-menu">
                <div class="dropdown-grid">
                  {servicesList.map(s => (
                    <a href={s.href} class="dropdown-item">
                      <span class="dropdown-item-title">{s.label}</span>
                      <span class="dropdown-item-desc">{s.desc}</span>
                    </a>
                  ))}
                </div>
              </div>
            </li>
          ) : (
            <li><a href={item.href} class="nav-link">{item.label}</a></li>
          )
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href="tel:+16626383777" class="phone-link" aria-label="Call us at (662) 638-3777">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>(662) 638-3777</span>
      </a>
      <a href="/contact" class="btn btn-primary btn-sm header-cta">Get a Quote</a>
    </div>

    <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobile-menu">
    <nav aria-label="Mobile navigation">
      <ul class="mobile-nav-list">
        <li><a href="/" class="mobile-nav-link">Home</a></li>
        <li class="mobile-heading">Services</li>
        {servicesList.map(s => (
          <li><a href={s.href} class="mobile-nav-sublink">{s.label}</a></li>
        ))}
        <li style="margin-top: 10px;"><a href="/about" class="mobile-nav-link">About Us</a></li>
        <li><a href="/faq" class="mobile-nav-link">FAQs</a></li>
        <li><a href="/contact" class="mobile-nav-link">Contact & Quote</a></li>
      </ul>
      <div class="mobile-cta">
        <a href="tel:+16626383777" class="btn btn-outline btn-lg mobile-phone">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (662) 638-3777
        </a>
        <a href="/contact" class="btn btn-primary btn-lg">Get a Free Quote</a>
      </div>
    </nav>
  </div>
</header>

<style>
  @import '../styles/global.css';

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: transparent;
    transition: all var(--transition);
  }

  .site-header.scrolled {
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 1px 20px rgba(0, 0, 0, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    gap: var(--space-xl);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    z-index: 10;
  }

  .logo img {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    object-fit: contain;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo-name {
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--white);
    transition: color var(--transition);
  }

  .logo-tagline {
    font-weight: 500;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.8);
    letter-spacing: 0.05em;
    transition: color var(--transition);
  }

  .scrolled .logo-name { color: var(--gray-900); }
  .scrolled .logo-tagline { color: var(--gray-500); }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .nav-link {
    padding: 0.5rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    border-radius: var(--border-radius-sm);
    transition: all var(--transition);
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link:hover {
    color: var(--white);
    background: rgba(255, 255, 255, 0.1);
  }

  .scrolled .nav-link {
    color: var(--gray-600);
  }

  .scrolled .nav-link:hover {
    color: var(--brand-red);
    background: var(--gray-50);
  }

  /* Dropdown Menu */
  .nav-dropdown-wrapper {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: -20px;
    width: 460px;
    background: var(--white);
    border-radius: var(--border-radius);
    padding: var(--space-md);
    box-shadow: var(--shadow-xl);
    border: 1px solid var(--gray-200);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all var(--transition);
    pointer-events: none;
  }

  .nav-dropdown-wrapper:hover .dropdown-menu,
  .nav-dropdown-wrapper:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .dropdown-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .dropdown-item {
    display: flex;
    flex-direction: column;
    padding: 8px 12px;
    border-radius: var(--border-radius-sm);
    transition: all var(--transition-fast);
  }

  .dropdown-item:hover {
    background: var(--gray-50);
  }

  .dropdown-item-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--gray-900);
  }

  .dropdown-item:hover .dropdown-item-title {
    color: var(--brand-red);
  }

  .dropdown-item-desc {
    font-size: 0.76rem;
    color: var(--gray-500);
    line-height: 1.3;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .phone-link {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--white);
    transition: color var(--transition);
  }

  .phone-link:hover { color: var(--brand-red-light); }
  .scrolled .phone-link { color: var(--gray-700); }
  .scrolled .phone-link:hover { color: var(--brand-red); }

  .header-cta {
    padding: 0.55rem 1.5rem;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 10;
  }

  .hamburger-line {
    display: block;
    width: 24px;
    height: 2.5px;
    background: var(--white);
    border-radius: 2px;
    transition: all var(--transition);
  }

  .scrolled .hamburger-line { background: var(--gray-800); }

  .mobile-toggle.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }
  .mobile-toggle.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .mobile-toggle.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(6px, -6px);
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(10, 15, 26, 0.98);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    opacity: 0;
    visibility: hidden;
    transition: all var(--transition);
    overflow-y: auto;
    padding: 80px 20px 40px;
  }

  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav-list {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .mobile-nav-link {
    display: block;
    padding: 8px 16px;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--white);
    transition: color var(--transition);
  }

  .mobile-heading {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--brand-red-light);
    margin-top: 14px;
    margin-bottom: 4px;
  }

  .mobile-nav-sublink {
    display: block;
    padding: 4px 12px;
    font-size: 1.05rem;
    color: var(--gray-300);
    font-weight: 500;
  }

  .mobile-nav-sublink:hover,
  .mobile-nav-link:hover { color: var(--brand-red-light); }

  .mobile-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .mobile-cta .btn {
    min-width: 260px;
    justify-content: center;
  }

  @media (max-width: 1024px) {
    .main-nav { display: none; }
    .header-actions { display: none; }
    .mobile-toggle { display: flex; }
  }
</style>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const header = document.getElementById('site-header');
    const toggle = document.getElementById('mobile-toggle');
    const menu = document.getElementById('mobile-menu');

    const handleScroll = () => {
      if (window.scrollY > 50) {
        header?.classList.add('scrolled');
      } else {
        header?.classList.remove('scrolled');
      }
    };
    window.addEventListener('scroll', handleScroll);
    handleScroll();

    toggle?.addEventListener('click', () => {
      toggle.classList.toggle('active');
      menu?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', toggle.classList.contains('active').toString());
      document.body.style.overflow = menu?.classList.contains('open') ? 'hidden' : '';
    });

    menu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggle?.classList.remove('active');
        menu?.classList.remove('open');
        document.body.style.overflow = '';
      });
    });
  });
</script>
