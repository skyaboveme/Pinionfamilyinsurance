---
/**
 * ProductPageLayout
 * Shared template for insurance product pages (flood, umbrella, boat, farm, ...).
 * Mirrors the design of the original product pages (e.g. motorcycle-insurance.astro)
 * and auto-generates Service, BreadcrumbList, and FAQPage structured data.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CarrierStrip from '../components/CarrierStrip.astro';
import FAQ from '../components/FAQ.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import QuoteForm from '../components/QuoteForm.astro';
import '../styles/global.css';

interface CoverageItem { title: string; text: string; }
interface FAQItem { question: string; answer: string; }

interface Props {
  slug: string;               // e.g. "flood-insurance"
  metaTitle: string;
  metaDescription: string;
  keywords?: string;
  serviceName: string;        // Schema Service name
  serviceType: string;        // Short product name, also used for breadcrumbs + quote form
  heroImage: string;
  heroAlt: string;
  eyebrow: string;
  h1: string;
  h1Highlight?: string;
  heroDesc: string;
  ctaLabel: string;
  sectionEyebrow: string;
  h2: string;
  leadText: string;
  coverageTitle: string;
  coverage: CoverageItem[];
  tagsTitle: string;
  tags: string[];
  quoteTitle: string;
  trustTitle: string;
  trustPoints: { icon: string; label: string; text: string }[];
  faqTitle: string;
  faqSubtitle: string;
  faqs: FAQItem[];
}

const p = Astro.props;
const url = `https://pinionfamilyinsurance.com/${p.slug}`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": p.serviceName,
    "serviceType": p.serviceType,
    "url": url,
    "provider": {
      "@type": "InsuranceAgency",
      "@id": "https://pinionfamilyinsurance.com/#organization",
      "name": "Pinion Family Insurance",
      "telephone": "+16626383777",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "2621A W Oxford Loop",
        "addressLocality": "Oxford",
        "addressRegion": "MS",
        "postalCode": "38655"
      }
    },
    "description": p.metaDescription,
    "areaServed": ["Oxford", "Lafayette County", "North Mississippi", "Mississippi"]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://pinionfamilyinsurance.com/" },
      { "@type": "ListItem", "position": 2, "name": p.serviceType, "item": url }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": p.faqs.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  }
];
---

<BaseLayout
  title={p.metaTitle}
  description={p.metaDescription}
  keywords={p.keywords}
  canonical={url}
  schema={schema}
>
  <Header />

  <!-- Hero Section -->
  <section class="page-hero">
    <div class="page-hero-bg">
      <img src={p.heroImage} alt={p.heroAlt} width="1376" height="768" loading="eager" />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="container page-hero-content">
      <div class="breadcrumbs">
        <a href="/">Home</a> <span>/</span> <span class="current">{p.serviceType}</span>
      </div>
      <span class="hero-eyebrow">{p.eyebrow}</span>
      <h1>{p.h1}{p.h1Highlight && <> <span class="highlight-text">{p.h1Highlight}</span></>}</h1>
      <p class="hero-desc">{p.heroDesc}</p>
      <div class="hero-btn-group">
        <a href="#quote-section" class="btn btn-primary btn-lg">{p.ctaLabel}</a>
        <a href="tel:+16626383777" class="btn btn-outline btn-lg">Call (662) 638-3777</a>
      </div>
    </div>
  </section>

  <!-- Content & Quote Grid -->
  <section class="section" id="quote-section">
    <div class="container">
      <div class="service-layout-grid">
        <div class="service-details">
          <span class="section-eyebrow">{p.sectionEyebrow}</span>
          <h2>{p.h2}</h2>
          <p class="lead-text">{p.leadText}</p>

          <div class="coverage-features-box">
            <h3>{p.coverageTitle}</h3>
            <ul class="coverage-list">
              {p.coverage.map(c => (
                <li>
                  <div class="check-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                  <div>
                    <strong>{c.title}</strong>
                    <p>{c.text}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <!-- Optional page-specific content -->
          <slot />

          <div class="discounts-callout">
            <h3>{p.tagsTitle}</h3>
            <div class="discount-tags">
              {p.tags.map(t => <span class="tag">{t}</span>)}
            </div>
          </div>
        </div>

        <div class="service-sidebar">
          <QuoteForm defaultInsuranceType={p.serviceType} formTitle={p.quoteTitle} />

          <div class="local-trust-card">
            <h4>{p.trustTitle}</h4>
            <ul class="trust-points">
              {p.trustPoints.map(t => (
                <li>{t.icon} <strong>{t.label}:</strong> {t.text}</li>
              ))}
            </ul>
            <div class="call-direct">
              <span>Ready for a quick quote?</span>
              <a href="tel:+16626383777" class="direct-phone-btn">📞 (662) 638-3777</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CarrierStrip />

  <FAQ title={p.faqTitle} subtitle={p.faqSubtitle} items={p.faqs} idPrefix={p.slug} />

  <Footer />
  <FloatingCTA />
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    background: linear-gradient(135deg, var(--navy) 0%, #0d1726 100%);
    padding: calc(var(--header-height) + var(--space-3xl)) 0 var(--space-4xl);
    color: var(--white);
    overflow: hidden;
  }
  .page-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .page-hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .page-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(135deg, rgba(10, 15, 26, 0.90) 0%, rgba(10, 15, 26, 0.75) 45%, rgba(10, 15, 26, 0.88) 100%);
  }
  .page-hero-content { position: relative; z-index: 2; max-width: 840px; }
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--gray-400);
    margin-bottom: var(--space-md);
  }
  .breadcrumbs a { color: var(--gray-300); }
  .breadcrumbs a:hover { color: var(--white); }
  .breadcrumbs .current { color: var(--brand-red-light); font-weight: 600; }
  .hero-eyebrow {
    display: inline-block;
    color: var(--brand-red-light);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-xs);
  }
  .page-hero h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    color: var(--white);
    margin-bottom: var(--space-md);
  }
  .highlight-text { color: var(--brand-red-light); }
  .hero-desc {
    font-size: 1.15rem;
    color: var(--gray-300);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }
  .hero-btn-group { display: flex; gap: var(--space-md); flex-wrap: wrap; }

  .service-layout-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }
  .service-details h2 { font-size: 2.2rem; margin-bottom: var(--space-md); color: var(--gray-900); }
  .lead-text {
    font-size: 1.1rem;
    color: var(--gray-600);
    line-height: 1.8;
    margin-bottom: var(--space-2xl);
  }
  .coverage-features-box {
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    border-radius: var(--border-radius-lg);
    padding: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }
  .coverage-features-box h3 { font-size: 1.35rem; margin-bottom: var(--space-lg); color: var(--navy); }
  .coverage-list { display: flex; flex-direction: column; gap: var(--space-lg); }
  .coverage-list li { display: flex; gap: var(--space-md); align-items: flex-start; }
  .check-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(235, 29, 36, 0.1);
    color: var(--brand-red);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .coverage-list strong { display: block; color: var(--gray-900); font-size: 1.05rem; margin-bottom: 3px; }
  .coverage-list p { color: var(--gray-600); font-size: 0.95rem; line-height: 1.5; }

  /* Optional slot content styling */
  .service-details :global(.info-callout) {
    background: #fffbeb;
    border-left: 4px solid #f59e0b;
    border-radius: var(--border-radius-sm);
    padding: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }
  .service-details :global(.info-callout h3) { color: #92400e; font-size: 1.15rem; margin-bottom: var(--space-xs); }
  .service-details :global(.info-callout p) { color: #78350f; font-size: 0.95rem; line-height: 1.6; margin: 0; }
  .service-details :global(.info-callout a) { color: #92400e; font-weight: 700; text-decoration: underline; }

  .discounts-callout {
    background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
    color: var(--white);
    padding: var(--space-xl);
    border-radius: var(--border-radius-lg);
  }
  .discounts-callout h3 { color: var(--white); font-size: 1.2rem; margin-bottom: var(--space-sm); }
  .discount-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .discount-tags .tag {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 6px 14px;
    border-radius: var(--border-radius-pill);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .service-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    position: sticky;
    top: calc(var(--header-height) + 20px);
  }
  .local-trust-card {
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    border-radius: var(--border-radius-lg);
    padding: var(--space-xl);
  }
  .local-trust-card h4 { font-size: 1.15rem; color: var(--navy); margin-bottom: var(--space-md); }
  .trust-points {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-size: 0.92rem;
    color: var(--gray-700);
    margin-bottom: var(--space-lg);
  }
  .call-direct {
    border-top: 1px solid var(--gray-200);
    padding-top: var(--space-md);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .call-direct span { font-size: 0.85rem; color: var(--gray-500); }
  .direct-phone-btn { font-weight: 700; font-size: 1.1rem; color: var(--brand-red); }
  .direct-phone-btn:hover { color: var(--brand-red-dark); }

  @media (max-width: 992px) {
    .service-layout-grid { grid-template-columns: 1fr; }
    .service-sidebar { position: static; }
  }
</style>
